{
  "datasets": [
    {
      "name": "ec1f1fe6",
      "displayName": "Sales Star (fact_sales + dims)",
      "config": {
        "source": "tpch_sales.gold.fact_sales",
        "measures": [
          {
            "displayName": "Net Revenue",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "abbreviation": "compact",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            },
            "name": "net_revenue",
            "expr": "SUM(source.extended_price * (1 - source.discount))",
            "comment": "Sum of extended price net of discount"
          },
          {
            "displayName": "Orders",
            "format": {
              "type": "number",
              "abbreviation": "compact"
            },
            "name": "order_count",
            "expr": "COUNT(DISTINCT source.order_key)",
            "comment": "Distinct orders"
          },
          {
            "displayName": "Active Customers",
            "format": {
              "type": "number",
              "abbreviation": "compact"
            },
            "name": "active_customers",
            "expr": "COUNT(DISTINCT source.customer_key)",
            "comment": "Distinct customers with at least one order line"
          },
          {
            "displayName": "Average Order Value",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "abbreviation": "compact",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            },
            "name": "avg_order_value",
            "expr": "MEASURE(`net_revenue`) / MEASURE(`order_count`)",
            "comment": "Net revenue per distinct order"
          },
          {
            "displayName": "Avg Discount",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            },
            "name": "avg_discount",
            "expr": "AVG(source.discount)",
            "comment": "Average line discount rate"
          },
          {
            "displayName": "Avg Ship Days",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            },
            "name": "avg_ship_days",
            "expr": "AVG(DATEDIFF(source.receipt_date, source.ship_date))",
            "comment": "Average days from ship date to receipt date"
          }
        ],
        "version": "1.1",
        "comment": "Star-joined sales model for the TPC-H Gold analytics dashboard",
        "dimensions": [
          {
            "name": "order_date",
            "expr": "source.order_date",
            "comment": "Order date"
          },
          {
            "name": "order_month",
            "expr": "DATE_TRUNC('MONTH', source.order_date)",
            "comment": "Calendar month of the order date"
          },
          {
            "name": "customer_region",
            "expr": "source.customer_region_name",
            "comment": "Customer region"
          },
          {
            "name": "customer_nation",
            "expr": "source.customer_nation_name",
            "comment": "Customer nation"
          },
          {
            "name": "supplier_region",
            "expr": "source.supplier_region_name",
            "comment": "Supplier region"
          },
          {
            "name": "supplier_nation",
            "expr": "source.supplier_nation_name",
            "comment": "Supplier nation"
          },
          {
            "name": "market_segment",
            "expr": "customers.market_segment",
            "comment": "Customer market segment"
          },
          {
            "name": "customer_name",
            "expr": "customers.customer_name",
            "comment": "Customer name"
          },
          {
            "name": "product_name",
            "expr": "products.product_name",
            "comment": "Product name"
          },
          {
            "name": "supplier_name",
            "expr": "suppliers.supplier_name",
            "comment": "Supplier name"
          },
          {
            "name": "ship_mode",
            "expr": "source.ship_mode",
            "comment": "Ship mode"
          }
        ],
        "joins": [
          {
            "name": "customers",
            "source": "tpch_sales.gold.dim_customer",
            "cardinality": "many_to_one",
            "on": "source.customer_key = customers.customer_key",
            "rely": {
              "atMostOneMatch": true
            }
          },
          {
            "name": "products",
            "source": "tpch_sales.gold.dim_product",
            "cardinality": "many_to_one",
            "on": "source.product_key = products.product_key",
            "rely": {
              "atMostOneMatch": true
            }
          },
          {
            "name": "suppliers",
            "source": "tpch_sales.gold.dim_supplier",
            "cardinality": "many_to_one",
            "on": "source.supplier_key = suppliers.supplier_key",
            "rely": {
              "atMostOneMatch": true
            }
          }
        ]
      }
    }
  ],
